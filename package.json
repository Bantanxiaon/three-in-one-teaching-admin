{
  "name": "chenyinpiano-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=2",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1073.0",
    "@aws-sdk/s3-request-presigner": "3.1073.0",
    "@hookform/resolvers": "5.4.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-label": "2.1.10",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.15",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ioredis": "5.11.1",
    "lucide-react": "0.468.0",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.13.0",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-email": "6.7.0",
    "react-hook-form": "7.80.0",
    "svix": "1.96.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.26",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "playwright": "1.62.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "sharp": "0.35.5",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.19",
    "socket.io-parser": "4.2.7",
    "minimatch@^10.2.2": {
      "brace-expansion": "5.0.12"
    },
    "postcss": "$postcss",
    "engine.io": "6.6.10"
  },
  "license": "MIT",
  "description": "Authentication and teaching operations management extracted from Chenyin Piano."
}
